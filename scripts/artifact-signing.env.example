# Azure Artifact Signing (formerly Trusted Signing) configuration.
# Copy to scripts/artifact-signing.env and fill in; do NOT commit the filled file.

# Signing endpoint for your region, e.g. https://eus.codesigning.azure.net/
ARTIFACT_SIGNING_ENDPOINT=

# Artifact Signing account name
ARTIFACT_SIGNING_ACCOUNT=

# Certificate profile names (one Public Trust, one Private Trust)
ARTIFACT_SIGNING_CERT_PROFILE_PUBLIC=
ARTIFACT_SIGNING_CERT_PROFILE_PRIVATE=

# Path to the Artifact Signing signtool dlib
# (installed with the Artifact Signing client tools on the signing machine)
ARTIFACT_SIGNING_DLIB_PATH=C:\tools\Azure.CodeSigning.Dlib.dll
