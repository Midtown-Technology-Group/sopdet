{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/bifrost-device-inventory/2.0.0/inventory.schema.json",
  "title": "Device Inventory Envelope",
  "description": "Read-only endpoint inventory snapshot. One envelope per scan; entities are per-entity record collections with a natural key and content fingerprint. Field naming is snake_case; sizes are bytes, durations seconds, clocks Hz/MTs, timestamps ISO-8601 UTC.",
  "type": "object",
  "required": ["schema_version", "scan_id", "action", "host_identifier", "calendar_time", "unix_time", "entities"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 2 },
    "scan_id": { "type": "string", "format": "uuid" },
    "base_scan_id": { "type": ["string", "null"], "description": "For action=delta, the scan_id this delta is relative to" },
    "action": { "enum": ["snapshot", "delta", "added", "removed", "changed"] },
    "partial": { "type": "boolean", "description": "true when a reduced profile was collected" },
    "host_identifier": {
      "type": "object",
      "required": ["device_id", "device_id_source"],
      "properties": {
        "device_id": { "type": "string", "minLength": 8 },
        "device_id_source": { "enum": ["machine_guid", "smbios_uuid", "instance"] },
        "hardware_uuid": { "type": ["string", "null"], "description": "DMTF/SMBIOS hardware UUID; survives OS reinstall" },
        "machine_guid": { "type": ["string", "null"] },
        "instance_id": { "type": "string", "description": "Per-install persisted random id" },
        "hostname": { "type": "string" },
        "fqdn": { "type": ["string", "null"] }
      }
    },
    "calendar_time": { "type": "string", "format": "date-time" },
    "unix_time": { "type": "integer" },
    "received_at": { "type": ["string", "null"], "format": "date-time", "description": "Server/transaction time; null until ingest" },
    "decorators": {
      "type": "object",
      "properties": {
        "username": { "type": ["string", "null"] },
        "upn": { "type": ["string", "null"] },
        "uptime_seconds": { "type": ["integer", "null"] },
        "os_platform": { "type": "string" },
        "is_elevated": { "type": "boolean" }
      }
    },
    "agent": {
      "type": "object",
      "required": ["name", "version", "os"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "os": { "type": "string" },
        "arch": { "type": ["string", "null"] },
        "elevated": { "type": "boolean" },
        "powershell": { "type": ["string", "null"] },
        "profile": { "enum": ["minimal", "quick", "full"] },
        "user": { "type": ["string", "null"] }
      }
    },
    "truncated": { "type": "array", "items": { "type": "string" } },
    "chunk": {
      "type": "object",
      "description": "Present when the envelope is a transport chunk; `entities` then holds only the listed subset.",
      "required": ["index", "count", "entities"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 1 },
        "entities": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entity_errors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" },
          "gated": { "type": "boolean", "description": "true when failure looks like access-denied / requires elevation" },
          "durationMs": { "type": "integer" }
        }
      }
    },
    "entities": {
      "type": "object",
      "description": "Keyed by entity type. Every value has the same collection shape.",
      "propertyNames": {
        "enum": [
          "host", "os", "hardware", "virtualization", "secureboot", "uac",
          "antivirus", "firewall_profiles", "volumes", "network_interfaces",
          "bios", "processors", "memory_modules", "graphics", "tpm",
          "software", "os_patches", "local_users", "logged_on_users",
          "batteries", "printers", "services", "startup_items", "drivers",
          "physical_disks", "listening_ports", "monitors", "usb_devices",
          "appx_packages", "processes", "raid_controllers", "antivirus_threats",
          "network_profiles", "wifi_networks", "proxy_config", "routes",
          "arp_neighbors", "scheduled_tasks", "remote_access",
          "privileged_members", "password_policy", "update_health",
          "reliability", "machine_certs", "usb_history", "runtimes", "recovery"
        ]
      },
      "additionalProperties": { "oneOf": [ { "$ref": "#/$defs/entityCollection" }, { "$ref": "#/$defs/entityDelta" } ] }
    }
  },
  "$defs": {
    "entityCollection": {
      "type": "object",
      "required": ["count", "fingerprint", "records"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "summarized": { "type": "boolean", "description": "true when the byte budget forced record truncation; omitted records are not reflected in state" },
        "omitted": { "type": "integer", "minimum": 0 }
      }
    },
    "entityDelta": {
      "type": "object",
      "required": ["count", "added", "changed", "removed", "unchanged"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "description": "current total record count for this entity" },
        "added": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "changed": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key"],
            "properties": {
              "key": { "type": "string" },
              "previous_fingerprint": { "type": ["string", "null"] }
            }
          }
        },
        "unchanged": { "type": "integer", "minimum": 0 },
        "summarized": { "type": "boolean" },
        "omitted": { "type": "integer", "minimum": 0 }
      }
    },
    "compressedPayload": {
      "type": "object",
      "description": "Wire wrapper emitted with -Compress. data = base64(gzip(utf8(compact JSON envelope))).",
      "required": ["content_encoding", "data"],
      "properties": {
        "content_encoding": { "const": "gzip+base64" },
        "schema_version": { "type": "integer" },
        "action": { "type": "string" },
        "scan_id": { "type": "string" },
        "uncompressed_bytes": { "type": "integer" },
        "compressed_bytes": { "type": "integer" },
        "data": { "type": "string" }
      }
    },
    "record": {
      "type": "object",
      "required": ["key", "fingerprint", "observed_at"],
      "properties": {
        "key": { "type": "string", "description": "Natural key, unique within the entity type" },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 over the record's data fields (excludes key/fingerprint/observed_at)" },
        "observed_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "software": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": ["string", "null"] },
        "vendor": { "type": ["string", "null"] },
        "install_date": { "type": ["string", "null"], "description": "ISO date when parseable" },
        "install_location": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"] },
        "architecture": { "type": ["string", "null"], "enum": ["x64", "x86", "arm64", "auto", null] },
        "scope": { "enum": ["machine", "user"] },
        "format": { "type": ["string", "null"], "description": "msi | exe | appx | deb | rpm | pkg | ..." },
        "source": { "type": "string", "description": "registry | msi | appx | winget | choco | dpkg | rpm | brew | snap | flatpak" },
        "product_code": { "type": ["string", "null"] }
      }
    },
    "volume": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "properties": {
        "drive_letter": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "device_type": { "type": ["integer", "null"] },
        "file_system": { "type": ["string", "null"] },
        "capacity_bytes": { "type": ["integer", "null"] },
        "free_bytes": { "type": ["integer", "null"] },
        "used_percent": { "type": ["number", "null"] },
        "system_drive": { "type": "boolean" },
        "encrypt_name": { "type": ["string", "null"], "description": "BitLocker | cryptsetup | FileVault" },
        "encrypt_algo": { "type": ["string", "null"], "description": "AES_128 | AES_256 | XTS_AES_256 | HARDWARE_ENCRYPTION | ..." },
        "encrypt_status": { "type": ["string", "null"], "description": "on | off | partially | unknown" },
        "encrypt_type": { "type": ["string", "null"], "description": "hardware | software" }
      }
    },
    "networkInterface": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "properties": {
        "interface_index": { "type": ["integer", "null"] },
        "adapter_name": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "mac_address": { "type": ["string", "null"] },
        "ip_addresses": { "type": "array", "items": { "type": "string" } },
        "subnet_masks": { "type": "array", "items": { "type": "string" } },
        "default_gateway": { "type": "array", "items": { "type": "string" } },
        "dns_servers": { "type": "array", "items": { "type": "string" } },
        "dns_domain": { "type": ["string", "null"] },
        "dns_host_name": { "type": ["string", "null"] },
        "dhcp_enabled": { "type": ["boolean", "null"] },
        "dhcp_server": { "type": ["string", "null"] },
        "link_speed_bps": { "type": ["integer", "null"] },
        "mtu": { "type": ["integer", "null"] },
        "status": { "type": ["integer", "null"] },
        "service_name": { "type": ["string", "null"] },
        "up": { "type": ["boolean", "null"] }
      }
    },
    "physicalDisk": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "properties": {
        "index": { "type": ["integer", "null"] },
        "model": { "type": ["string", "null"] },
        "serial_number": { "type": ["string", "null"] },
        "size_bytes": { "type": ["integer", "null"] },
        "interface_type": { "type": ["string", "null"] },
        "media_type": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"], "description": "Drive health status (OK, Degraded, Pred Fail, ...)" },
        "predictive_failure": { "type": ["boolean", "null"], "description": "true when SMART predicts failure" },
        "partitions": { "type": ["integer", "null"] }
      }
    },
    "networkProfile": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Named network location awareness profile (Windows NLM).",
      "properties": {
        "profile_name": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "category": { "type": ["string", "null"], "description": "public | private | domain" },
        "category_id": { "type": ["integer", "null"] },
        "managed": { "type": ["boolean", "null"] }
      }
    },
    "wifiNetwork": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Wireless interface association state. No scan is performed.",
      "properties": {
        "interface": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "ssid": { "type": ["string", "null"] },
        "bssid": { "type": ["string", "null"] },
        "signal_percent": { "type": ["integer", "null"], "description": "Volatile: excluded from fingerprints" },
        "signal_dbm": { "type": ["integer", "null"], "description": "Volatile: excluded from fingerprints" },
        "radio_type": { "type": ["string", "null"] },
        "authentication": { "type": ["string", "null"] },
        "cipher": { "type": ["string", "null"] },
        "channel": { "type": ["integer", "null"] }
      }
    },
    "proxyConfig": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Single-record entity (key proxy): per-user and system proxy configuration.",
      "properties": {
        "user_proxy_enabled": { "type": ["boolean", "null"] },
        "user_proxy_server": { "type": ["string", "null"] },
        "user_proxy_bypass": { "type": ["string", "null"] },
        "user_autoconfig_url": { "type": ["string", "null"] },
        "system_proxy_server": { "type": ["string", "null"] },
        "system_proxy_bypass": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "routeEntry": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "IPv4 route table entry.",
      "properties": {
        "destination": { "type": ["string", "null"] },
        "mask": { "type": ["string", "null"] },
        "gateway": { "type": ["string", "null"] },
        "interface": { "type": ["string", "null"] },
        "metric": { "type": ["integer", "null"] },
        "family": { "type": ["string", "null"] },
        "persistent": { "type": ["boolean", "null"] }
      }
    },
    "arpNeighbor": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Read-only ARP/neighbor table entry. Nothing is probed or sent.",
      "properties": {
        "ip_address": { "type": ["string", "null"] },
        "mac_address": { "type": ["string", "null"] },
        "interface": { "type": ["string", "null"] },
        "neighbor_type": { "type": ["string", "null"], "description": "static | dynamic" },
        "neighbor_state": { "type": ["string", "null"], "description": "Volatile: excluded from fingerprints" }
      }
    },
    "scheduledTask": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Scheduled task / cron entry / timer / launchd job. Times are raw source strings except where ISO.",
      "properties": {
        "task_name": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "enabled": { "type": ["boolean", "null"] },
        "schedule": { "type": ["string", "null"] },
        "command": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "run_as_user": { "type": ["string", "null"] },
        "logon_mode": { "type": ["string", "null"] },
        "last_run_time": { "type": ["string", "null"] },
        "last_result": { "type": ["string", "null"] },
        "next_run_time": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"], "description": "schtasks | cron | systemd-timer | launchd" }
      }
    },
    "remoteAccess": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Single-record entity (key remote_access): inbound remote-access posture.",
      "properties": {
        "rdp_enabled": { "type": ["boolean", "null"] },
        "rdp_port": { "type": ["integer", "null"] },
        "rdp_nla_required": { "type": ["boolean", "null"] },
        "smb1_server": { "type": ["boolean", "null"] },
        "smb1_client": { "type": ["boolean", "null"] },
        "llmnr_enabled": { "type": ["boolean", "null"] },
        "netbios_mode": { "type": ["string", "null"] },
        "winrm_running": { "type": ["boolean", "null"] },
        "winrm_start_mode": { "type": ["string", "null"] },
        "sshd_installed": { "type": ["boolean", "null"] },
        "sshd_permit_root_login": { "type": ["string", "null"] },
        "sshd_password_auth": { "type": ["string", "null"] },
        "sshd_port": { "type": ["integer", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "privilegedMember": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Member of a privileged local group (Administrators, sudo, wheel, admin, docker).",
      "properties": {
        "name": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "member_type": { "type": ["string", "null"], "description": "user | group" },
        "source": { "type": ["string", "null"] }
      }
    },
    "passwordPolicy": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Single-record entity (key password_policy): local password and lockout policy.",
      "properties": {
        "max_password_age_days": { "type": ["integer", "null"] },
        "min_password_age_days": { "type": ["integer", "null"] },
        "min_password_length": { "type": ["integer", "null"] },
        "password_history": { "type": ["integer", "null"] },
        "lockout_threshold": { "type": ["integer", "null"] },
        "lockout_duration_minutes": { "type": ["integer", "null"] },
        "lockout_reset_minutes": { "type": ["integer", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "updateHealth": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Single-record entity (key update_health): patch pipeline health and pending reboot.",
      "properties": {
        "last_success_time": { "type": ["string", "null"] },
        "update_source": { "type": ["string", "null"] },
        "wsus_server": { "type": ["string", "null"] },
        "auto_update_option": { "type": ["integer", "null"] },
        "auto_updates": { "type": ["boolean", "null"] },
        "pending_reboot": { "type": ["boolean", "null"] },
        "pending_reboot_reasons": { "type": "array", "items": { "type": "string" } },
        "source": { "type": ["string", "null"] }
      }
    },
    "reliability": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Single-record entity (key reliability): unexpected shutdown / crash counters.",
      "properties": {
        "unexpected_shutdowns": { "type": ["integer", "null"] },
        "kernel_power_events": { "type": ["integer", "null"] },
        "bugchecks": { "type": ["integer", "null"] },
        "clean_shutdowns": { "type": ["integer", "null"] },
        "last_unexpected_shutdown": { "type": ["string", "null"] },
        "last_bugcheck": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "machineCert": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Local-machine personal store certificate. No private key material.",
      "properties": {
        "subject": { "type": ["string", "null"] },
        "issuer": { "type": ["string", "null"] },
        "serial_number": { "type": ["string", "null"] },
        "thumbprint": { "type": ["string", "null"] },
        "not_before": { "type": ["string", "null"] },
        "not_after": { "type": ["string", "null"] },
        "days_remaining": { "type": ["integer", "null"], "description": "Volatile: excluded from fingerprints" },
        "expired": { "type": ["boolean", "null"] },
        "expiring_soon": { "type": ["boolean", "null"] },
        "has_private_key": { "type": ["boolean", "null"] },
        "purposes": { "type": ["string", "null"] },
        "store": { "type": ["string", "null"] }
      }
    },
    "usbHistoryEntry": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Previously attached USB storage device (registry history, not just connected).",
      "properties": {
        "device": { "type": ["string", "null"] },
        "serial": { "type": ["string", "null"] },
        "friendly_name": { "type": ["string", "null"] },
        "container_id": { "type": ["string", "null"] }
      }
    },
    "runtimeEntry": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Managed runtime, interpreter, execution policy scope, or browser.",
      "properties": {
        "kind": { "type": ["string", "null"] },
        "name": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "path": { "type": ["string", "null"] },
        "machine_policy": { "type": ["string", "null"] },
        "user_policy": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "recovery": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "description": "Single-record entity (key recovery): recovery partition and WinRE status.",
      "properties": {
        "recovery_partition_present": { "type": ["boolean", "null"] },
        "recovery_partition_count": { "type": ["integer", "null"] },
        "recovery_total_bytes": { "type": ["integer", "null"] },
        "winre_status": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "antivirus": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "properties": {
        "name": { "type": "string" },
        "enabled": { "type": ["boolean", "null"] },
        "up_to_date": { "type": ["boolean", "null"] },
        "version": { "type": ["string", "null"] },
        "definition_version": { "type": ["string", "null"] },
        "product_state": { "type": ["string", "null"] }
      }
    },
    "listeningPort": {
      "allOf": [{ "$ref": "#/$defs/record" }],
      "properties": {
        "protocol": { "enum": ["tcp", "udp"] },
        "address": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "family": { "enum": ["ipv4", "ipv6"] },
        "pid": { "type": ["integer", "null"] },
        "process": { "type": ["string", "null"] }
      }
    }
  }
}
